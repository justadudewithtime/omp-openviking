{
  "name": "omp-openviking",
  "version": "0.1.0",
  "description": "OpenViking context memory for oh-my-pi: a thin fork of the upstream pi extension, tracked as a submodule.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "omp": {
    "extensions": ["index.ts"]
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update-upstream.mjs",
    "test": "node --test \"upstream/examples/pi-coding-agent-extension/tests/*.test.mjs\"",
    "lifecycle": "node test/lifecycle.mjs",
    "smoke": "node test/smoke.mjs",
    "stub": "node test/stub-server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justadudewithtime/omp-openviking.git"
  }
}
